# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env lên GitHub.
# Sinh khóa bí mật:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=doi_thanh_chuoi_ngau_nhien_dai

# --- MySQL ---
# Docker Compose: DB_HOST/DB_USER/DB_MANAGED đã được compose tự đặt, chỉ cần 2 mật khẩu dưới.
DB_ROOT_PASSWORD=doi_mat_khau_root
DB_PASSWORD=doi_mat_khau_app
# Chạy không Docker / dùng MySQL cloud (Aiven): điền các dòng sau
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_NAME=security_login_db
# DB_MANAGED=1   # bật khi database đã được tạo sẵn (Docker, Aiven): bỏ qua CREATE DATABASE
# DB_SSL_CA=ca.pem   # tuỳ chọn (Aiven): đường dẫn file CA để xác thực chứng chỉ

# --- Chế độ chạy ---
# LAB_MODE=1        # CHỈ bật khi chạy attack_simulator.py, xong phải tắt
# TRUSTED_PROXY_COUNT=0   # số proxy tin cậy phía trước app (Nginx trong compose = 1)
# COOKIE_SECURE=1   # bật khi chạy HTTPS (Render)
# AUTO_INIT_DB=1    # tự tạo bảng khi app khởi động
# DEV_PRINT_OTP=1   # in OTP ra log khi chưa có email thật (chỉ để demo)

# --- Email cảnh báo ---
# Cách 1: SMTP Gmail (chạy local/VM). Dùng App Password của Gmail.
EMAIL_PROVIDER=smtp
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
# Cách 2: Brevo HTTP API (BẮT BUỘC trên Render miễn phí vì Render chặn cổng SMTP)
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=your_brevo_api_key
# EMAIL_SENDER=email_da_xac_minh_tren_brevo@example.com

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_admin_chat_id

# --- Ngưỡng phát hiện (tuỳ chọn, mặc định theo đề tài) ---
# R1_MAX_GAP_SEC=1.0  R1_MIN_CONSECUTIVE=3  R2_MAX_FAILS=5  R2_WINDOW_SEC=60  R2_LOCK_MIN=15
# R3_MAX_FAILS=20  R3_WINDOW_SEC=300  R3_MIN_TARGETS=2  R3_BLOCK_MIN=30  CAPTCHA_MIN=30
